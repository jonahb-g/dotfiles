{
  "title": "WezTerm: mouse back/forward jump in nvim",
  "rules": [
    {
      "description": "WezTerm: mouse back/forward -> Alt+o / Alt+i (nvim jump back/forward)",
      "manipulators": [
        {
          "type": "basic",
          "from": { "pointing_button": "button4" },
          "to": [{ "key_code": "o", "modifiers": ["left_option"] }],
          "conditions": [
            { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.github\\.wez\\.wezterm$"] }
          ]
        },
        {
          "type": "basic",
          "from": { "pointing_button": "button5" },
          "to": [{ "key_code": "i", "modifiers": ["left_option"] }],
          "conditions": [
            { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.github\\.wez\\.wezterm$"] }
          ]
        }
      ]
    }
  ]
}
